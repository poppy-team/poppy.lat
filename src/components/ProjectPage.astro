---
import type { Locale, Project } from '../data/projects';
import SiteLayout from './SiteLayout.astro';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const copy = project.copy[locale];
const category = project.category[locale];
const rootPath = locale === 'en' ? '/en' : '';
const languageSwitchHref = locale === 'en'
  ? `/projetos/${project.slug}/`
  : `/en/projects/${project.slug}/`;
---

<SiteLayout
  locale={locale}
  title={project.name}
  description={copy.summary}
  languageSwitchHref={languageSwitchHref}
>
  <article class="project-page" aria-labelledby="project-title">
    <div class="project-page__topline">
      <a class="back-link" href={`${rootPath}/#projects`}>
        <span aria-hidden="true">←</span> {locale === 'en' ? 'All projects' : 'Todos os projetos'}
      </a>
      <span class="project-page__category">{category} · {project.number}</span>
    </div>

    <header class="project-page__hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 id="project-title">{project.name}<span class="project-page__period">.</span></h1>
      <p class="project-page__summary">{copy.summary}</p>
      <div class="project-page__links">
        <a class="button-link button-link--dark" href={project.repositoryHref}>
          {locale === 'en' ? 'Project repository' : 'Repositório do projeto'} <span aria-hidden="true">↗</span>
        </a>
        <a class="button-link button-link--light" href={copy.documentationHref}>
          {copy.documentationLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="project-page__body">
      <section class="project-section" aria-labelledby="purpose-title">
        <p class="project-section__index">01</p>
        <div>
          <p class="eyebrow">{locale === 'en' ? 'The question' : 'A pergunta'}</p>
          <h2 id="purpose-title">{copy.purposeTitle}</h2>
          <p>{copy.purpose}</p>
        </div>
      </section>

      <section class="project-section" aria-labelledby="philosophy-title">
        <p class="project-section__index">02</p>
        <div>
          <p class="eyebrow">{locale === 'en' ? 'A few coordinates' : 'Algumas coordenadas'}</p>
          <h2 id="philosophy-title">{copy.philosophyTitle}</h2>
          <ol class="principle-list">
            {copy.principles.map((principle, index) => (
              <li>
                <span class="principle-list__number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{principle.title}</h3>
                  <p>{principle.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="project-section project-section--demo" aria-labelledby="demo-title">
        <p class="project-section__index">03</p>
        <div>
          <p class="eyebrow">{locale === 'en' ? 'A static sample' : 'Uma amostra estática'}</p>
          <h2 id="demo-title">{copy.demoTitle}</h2>
          <figure class="code-plate">
            <figcaption class="code-plate__caption">
              <span>{copy.demo.label}</span>
              <span class="code-plate__language">{copy.demo.language}</span>
            </figcaption>
            <pre><code class={`language-${copy.demo.language}`}>{copy.demo.code}</code></pre>
          </figure>
          <p class="project-page__note">{copy.demo.note}</p>
        </div>
      </section>

      <aside class="project-source" aria-label={locale === 'en' ? 'Project source' : 'Fonte do projeto'}>
        <span class="project-source__stamp" aria-hidden="true">{project.name.slice(0, 1)}</span>
        <p>
          {locale === 'en'
            ? 'Project description and public documentation are maintained in the source repository.'
            : 'A descrição do projeto e sua documentação pública são mantidas no repositório de origem.'}
        </p>
        <a href={project.repositoryHref}>{locale === 'en' ? 'Visit the repository' : 'Visitar o repositório'} <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </article>
</SiteLayout>
