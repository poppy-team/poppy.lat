{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "site/.vitepress/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ori/docs/guides/first-project",
      "destination": "/ori/docs/guides/getting-started/first-project",
      "permanent": true
    },
    {
      "source": "/en/ori/docs/guides/first-project",
      "destination": "/en/ori/docs/guides/getting-started/first-project",
      "permanent": true
    },
    {
      "source": "/projetos/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    },
    {
      "source": "/en/projetos/:slug",
      "destination": "/en/projects/:slug",
      "permanent": true
    },
    {
      "source": "/docs/:project(ori|aipo|oride|prumo)/:path*",
      "destination": "/:project/docs/:path*",
      "permanent": true
    },
    {
      "source": "/en/docs/:project(ori|aipo|oride|prumo)/:path*",
      "destination": "/en/:project/docs/:path*",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/docs",
      "destination": "/en/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
